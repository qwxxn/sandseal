ARG BASE_IMAGE=ubuntu:24.04

FROM ${BASE_IMAGE}

# Use bash with pipefail so any failed command in a pipe aborts the build
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG UID=1000
ARG GID=1000
ARG AGENT_USERNAME=agent
ARG AGENT_HOME=/home/agent

# removes default ubuntu user whose id we need for the agent user
RUN touch /var/mail/ubuntu && chown ubuntu /var/mail/ubuntu && userdel -r ubuntu

# Every apt step below mounts /var/cache/apt and /var/lib/apt/lists as build caches, so a
# rebuild re-downloads only what changed upstream. The stock image ships docker-clean, which
# deletes the .debs right after each install and would leave those caches empty.
RUN rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache

# Optional replacement for the archive the base image points at. The stock hosts resolve to a
# global pool that some networks reach at a fraction of the speed of a country mirror.
# security.ubuntu.com is rewritten too: it is a separate host, often the slower of the two, and
# a country mirror carries the same -security pocket at the cost of a short sync delay.
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
      shopt -s nullglob; \
      files=(/etc/apt/sources.list /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list); \
      if [ ${#files[@]} -eq 0 ]; then echo "aptMirror: no apt sources to rewrite" >&2; exit 1; fi; \
      sed -i -E "s#https?://(archive|[a-z]{2}\.archive|security|ports)\.ubuntu\.com/ubuntu/?#${APT_MIRROR%/}/#g" "${files[@]}"; \
      echo "apt archive: ${APT_MIRROR%/}"; \
    fi

# Project-agnostic base image. Shared across all projects with identical inputs
# (base image, user, agent installs, machine-wide dependencies and setup hook). Only what
# a project adds on top of those lives in Dockerfile.overlay, built FROM this image.

# Latest package versions / agent releases are pulled fresh whenever CACHEBUST changes.
ARG CACHEBUST=1

## Base dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    jq \
    nano \
    vim \
    ripgrep \
    ca-certificates \
    gnupg \
    sudo

## Docker CLI
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
      && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list \
      && apt-get update \
      && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin

# Agent CLI installations (root phase — global packages)
COPY agent-installs/ /tmp/agent-installs/
RUN for agent_dir in /tmp/agent-installs/*/; do \
      agent=$(basename "${agent_dir}"); \
      if [ -f "/tmp/agent-installs/${agent}/install-root.sh" ]; then \
        chmod +x "/tmp/agent-installs/${agent}/install-root.sh" \
        && "/tmp/agent-installs/${agent}/install-root.sh"; \
      fi; \
    done

# Create agent user
# -l on useradd avoids a huge sparse /var/log/lastlog entry when host UID is very high
RUN groupadd -g "${GID}" "${AGENT_USERNAME}" \
    && useradd -l -u "${UID}" -g "${GID}" -m -d "${AGENT_HOME}" -s /bin/bash "${AGENT_USERNAME}" \
    && echo "${AGENT_USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${AGENT_USERNAME} \
    && (getent group docker || groupadd docker) && usermod -aG docker "${AGENT_USERNAME}"

# Persist the agent username so the overlay image can restore it after its root steps
ENV SANDSEAL_USER=${AGENT_USERNAME}

# Prepare Agent CLI installations (user phase — user-space tools)
RUN for agent_dir in /tmp/agent-installs/*/; do \
      agent=$(basename "${agent_dir}"); \
      if [ -f "/tmp/agent-installs/${agent}/install-user.sh" ]; then \
        chown "${AGENT_USERNAME}" "/tmp/agent-installs/${agent}/install-user.sh" && \
        chmod +x "/tmp/agent-installs/${agent}/install-user.sh"; \
      fi; \
    done

USER ${AGENT_USERNAME}

# Execute Agent CLI installations (user phase — user-space tools)
ENV HOME=${AGENT_HOME}
ENV LANG=C.UTF-8

# support for non-interactive shells (agents run non-interactively), e.g. using NVM in non-interactive shells
ENV BASH_ENV="${AGENT_HOME}/.bash_env"
RUN touch "${AGENT_HOME}/.bash_env"
RUN echo '[ -s "${BASH_ENV}" ] && . "${BASH_ENV}"' >> "${AGENT_HOME}/.bashrc"

RUN for agent_dir in /tmp/agent-installs/*/; do \
      agent=$(basename "${agent_dir}"); \
      if [ -f "/tmp/agent-installs/${agent}/install-user.sh" ]; then \
        "/tmp/agent-installs/${agent}/install-user.sh"; \
      fi; \
    done

USER root

# Cleanup install scripts
RUN rm -rf /tmp/agent-installs

# apt-get wrapper (logs runtime-installed packages for auto-suggest)
COPY apt-wrapper.sh /usr/local/bin/apt-get
RUN chmod +x /usr/local/bin/apt-get

# Prepare entrypoint script
COPY entrypoint.sh /tmp/entrypoint.sh
RUN chmod +x /tmp/entrypoint.sh

ENV PATH="${AGENT_HOME}/.local/bin:$PATH"

# Everything below comes from settings the project did not touch, so it is the same for every
# project on this machine and is installed here once instead of in each project's overlay.
# It sits last on purpose: changing it leaves the layers above cached.

## Machine-wide dependencies
# Call the real apt-get directly (not the /usr/local/bin wrapper) so these build-time
# installs are not logged as runtime packages.
ARG SHARED_PACKAGES=""
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    if [ -n "$SHARED_PACKAGES" ]; then \
      /usr/bin/apt-get update && /usr/bin/apt-get install -y --no-install-recommends $SHARED_PACKAGES; \
    fi

## Machine-wide setup hook (runs as root — can install system packages, configure locales, etc.)
COPY setup-scripts/ /tmp/setup-scripts/
RUN if [ -f /tmp/setup-scripts/setup.sh ]; then \
      chmod +x /tmp/setup-scripts/setup.sh && \
      /tmp/setup-scripts/setup.sh; \
    fi
RUN rm -rf /tmp/setup-scripts

USER ${AGENT_USERNAME}

ENTRYPOINT ["/tmp/entrypoint.sh"]
